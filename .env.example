# Copy to .env.local for development. Never commit .env.local.

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset locally: the app uses an embedded Postgres (PGlite)
# in .data/pglite. On Vercel, set it from the Neon integration.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# PGLITE_DIR=.data/pglite

# --- Admin sign-in (Better Auth) -------------------------------------------
# Comma-separated list of Google accounts allowed into /admin.
ADMIN_EMAILS=you@example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's own origin; the passkey relying-party id is derived from it.
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Development conveniences. Both are ignored when NODE_ENV=production.
# Enables email+password sign-in for the allow-listed address (seed it with
# `yarn admin:seed`), so the dashboard works without Google or an authenticator.
ADMIN_DEV_PASSWORD_LOGIN=false
# Skip the passkey requirement while developing.
ADMIN_REQUIRE_PASSKEY=true

# --- Email (Resend) — step 4, not used yet --------------------------------
# RESEND_API_KEY=
# MAIL_FROM="Gravas <info@gravas.lv>"
